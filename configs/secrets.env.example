# ---------------------------------------------------------------------------
# Template for configs/secrets.env  (the real file is gitignored -- never commit it).
# Copy and fill in real values:
#     cp configs/secrets.env.example configs/secrets.env
#
# Loaded into the environment by core.config.load_secrets_env() before any VLM
# config is resolved. Values may be quoted; KEY = "v" is fine. A variable already
# exported in your shell takes precedence over the file, and an optional
# gitignored per-machine overlay configs/secrets.local.env is read on top.
# ---------------------------------------------------------------------------

# Hosted-VLM API keys. Referenced from configs/*.yaml via api_key_env.
GEMINI_API_KEY=""    # vlm_backends.gemini   (provider: gemini) -- the default zero-shot backend
CHATGPT_API_KEY=""   # vlm_backends.chatgpt  (provider: openai)

# API key the local vLLM server expects. Leave EMPTY unless started with --api-key.
VLLM_API_KEY="EMPTY"
